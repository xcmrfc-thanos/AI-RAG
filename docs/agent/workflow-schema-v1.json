{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-rag.local/schemas/agent-workflow-v1.json",
  "title": "AgentWorkflowV1",
  "description": "Agent 工作流定义 schemaVersion=1（线性链 + 条件二分支）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "nodes", "edges"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/toolNode" },
          { "$ref": "#/$defs/llmNode" },
          { "$ref": "#/$defs/conditionNode" }
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1, "maxLength": 64 },
          "to": { "type": "string", "minLength": 1, "maxLength": 64 },
          "when": {
            "type": "string",
            "enum": ["true", "false"],
            "description": "条件节点出边标签；非条件节点不得填写"
          }
        }
      }
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
    },
    "toolNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "tool", "input"],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "type": { "const": "tool" },
        "tool": {
          "type": "string",
          "enum": [
            "hybrid_search",
            "get_document",
            "list_documents",
            "list_categories",
            "list_tags",
            "hot_documents",
            "latest_documents",
            "graph_search",
            "text_template"
          ]
        },
        "input": {
          "type": "object"
        }
      }
    },
    "llmNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "input"],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "type": { "const": "llm" },
        "input": {
          "type": "object",
          "required": ["prompt"],
          "additionalProperties": true,
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "conditionNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "input"],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "type": { "const": "condition" },
        "input": {
          "type": "object",
          "required": ["expression"],
          "additionalProperties": true,
          "properties": {
            "expression": {
              "type": "string",
              "minLength": 1,
              "description": "变量展开后的简易真值或比较表达式，如 ${input.score} >= 60"
            }
          }
        }
      }
    }
  }
}
