# ==================== AI-RAG 根仓库过滤 ====================
# 根仓跟踪：README.md / docs / deploy / backend / frontend（构建产物与密钥除外）
# 本地可另有嵌套 .git，不影响根仓推送

# ---------- 密钥与本地环境 ----------
.mcp.json
.env
.env.*
!.env.example
!**/env.example
!/deploy/env.example
**/credentials.json
**/secret*.yml
**/secret*.yaml
*.pem
*.key
*.p12
*.jks
docs/lingclaw/

# ---------- deploy：本地运行产物与密钥（勿提交） ----------
/deploy/.env
/deploy/.env.*
/deploy/logs/
/deploy/tmp/
/deploy/**/data/
/deploy/**/*.log
/deploy/**/*.out
/deploy/**/*.err
/deploy/**/*.hprof
/deploy/**/*.pid
/deploy/**/*.dump
/deploy/docker-compose.override.yml
/deploy/**/.DS_Store
/deploy/scripts/_archive/**
!/deploy/scripts/_archive/README.md

# ---------- SkyWalking：本地下载的 Agent 包与解压产物（勿提交，配置文件除外） ----------
/deploy/skywalking/apache-skywalking-apm-*.tar.gz
/deploy/skywalking/apache-skywalking-apm-*/
/deploy/skywalking/agent/
!/deploy/skywalking/application.yml

