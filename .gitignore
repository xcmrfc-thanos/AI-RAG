# ==================== AI-RAG 根仓库过滤 ====================
# 根仓跟踪：readme.md / docs / deploy / backend / frontend（构建产物与密钥除外）
# 本地可另有嵌套 .git，不影响根仓推送

# ---------- 密钥与本地环境 ----------
.env
.env.*
!.env.example
!**/env.example
!/deploy/env.example
**/credentials.json
**/secret*.yml
**/secret*.yaml
*.pem
*.key
*.p12
*.jks

# ---------- deploy：本地运行产物与密钥（勿提交） ----------
/deploy/.env
/deploy/.env.*
/deploy/logs/
/deploy/tmp/
/deploy/**/data/
/deploy/**/*.log
/deploy/**/*.out
/deploy/**/*.err
/deploy/**/*.hprof
/deploy/**/*.pid
/deploy/**/*.dump
/deploy/docker-compose.override.yml
/deploy/**/.DS_Store
/deploy/scripts/_archive/**
!/deploy/scripts/_archive/README.md

# ---------- 网关切流历史脚本（本地归档，勿提交） ----------
/backend/kb-gateway/scripts/_archive/**
!/backend/kb-gateway/scripts/_archive/README.md

# ---------- SQL：历史 master-sql / migration 本地归档（勿提交） ----------
/backend/sql/_archive/**
!/backend/sql/_archive/README.md

# ---------- docs：本地草稿 / 实验 / 评测人工产物（勿提交） ----------
/docs/feat/
/docs/**/draft/
/docs/**/tmp/
/docs/**/*.local.md
/docs/**/*.local.*
/docs/eval/*judgement*
/docs/eval/*-judgement.*
/docs/eval/*-result*.csv
/docs/eval/*-output*.csv
/docs/eval/*.xlsx
/docs/eval/~$*

# ---------- 本地开发变更记录（仅本机保留，勿提交） ----------
/readme_plan.md
readme_plan.md

# ---------- 构建与依赖 ----------
**/node_modules/
**/dist/
**/dist-ssr/
**/target/
**/coverage/
**/.turbo/
**/.cache/
*.jar
*.war
*.ear
!**/maven-wrapper.jar

# ---------- 日志与临时文件 ----------
logs/
*.log
*.tmp
*.temp
*.swp
*.swo
*~
hs_err_pid*
replay_pid*

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln
.project
.classpath
.settings/
out/
bin/

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ---------- Cursor / 本地工具 ----------
.cursor/
.claude/
**/agent-transcripts/

# ---------- 本地嵌套仓备份（不入库） ----------
/.git-nested-backup/

