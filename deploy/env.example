# AI-RAG 本地 Docker 环境变量示例（复制为 deploy/.env）
COMPOSE_PROJECT_NAME=ai-rag

# ---------- 宿主机映射端口（20000-21000）----------
MYSQL_PORT=20006
REDIS_PORT=20079
RABBITMQ_PORT=20572
RABBITMQ_MGMT_PORT=20156
MONGO_PORT=20017
ES_PORT=20920
NEO4J_HTTP_PORT=20474
NEO4J_BOLT_PORT=20687
RUSTFS_PORT=20090
RUSTFS_CONSOLE_PORT=20091
NACOS_PORT=20848
NACOS_GRPC_PORT=21848

# ---------- 账号密码 ----------
MYSQL_ROOT_PASSWORD=123456
REDIS_PASSWORD=susan123
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=susan123
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=susan123
MONGO_APP_USER=mongodb
MONGO_APP_PASSWORD=susan123
MONGO_DATABASE=knowledge_base
ELASTIC_PASSWORD=susan123
NEO4J_AUTH=neo4j/susan123
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=kb-files
NACOS_USER=nacos
NACOS_PASSWORD=nacos
NACOS_NAMESPACE=knowledge
NACOS_GROUP=KNOWLEDGE_BASE

NACOS_ADDR=127.0.0.1:20848
ES_URL=http://127.0.0.1:20920

JVM_XMS=256m
JVM_XMX=512m
JVM_INTELLIGENCE_XMS=512m
JVM_INTELLIGENCE_XMX=1g

# 关系数据库方言：mysql | postgresql | oracle（默认 mysql）
KB_DB_TYPE=mysql

# ---------- AI 双环境（文档约定；实际靠下方变量生效）----------
# public = 公网 DashScope/DeepSeek + 可选硅基向量；intranet = 内网 Ollama
# 完整样例见 deploy/profiles/public.env.example 与 intranet.env.example
AI_PROFILE=public
# 本地无 Key 验收可 true；接真模型务必 false
AI_DEV_STUB=false

# 对话（OpenAI 兼容；默认通义 Qwen Max）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-max
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 硅基流动（根节点；向量默认用这组凭证）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# RAG / ES 向量（默认开启；vector-store=elasticsearch）
RAG_ENABLED=true
RAG_VECTOR_STORE=elasticsearch

# 向量模型：硅基 BAAI/bge-m3（凭证用 SILICONFLOW_*；勿与通义 embedding 混用同一索引）
# 改回通义：provider=qwen model=text-embedding-v3，清空下方覆盖项后回退 QWEN_*
RAG_EMBEDDING_PROVIDER=siliconflow
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=
RAG_RERANK_ENABLED=true
# 重排：api=专用接口（推荐）| off | llm（慢，不推荐）
RAG_RERANK_MODE=api
# auto=跟随 RAG_EMBEDDING_PROVIDER；也可 qwen | siliconflow | custom
RAG_RERANK_PROVIDER=auto
RAG_RERANK_MODEL=
RAG_RERANK_API_KEY=
RAG_RERANK_BASE_URL=
RAG_RERANK_MAX_CANDIDATES=20
KAG_ENABLED=true
RAG_QDRANT_ENABLED=true
QDRANT_HOST=127.0.0.1
QDRANT_HTTP_PORT=26333
QDRANT_GRPC_PORT=26334
RAG_HYBRID_FUSION=rrf
RAG_HYBRID_BM25_WEIGHT=0.5
RAG_HYBRID_DENSE_WEIGHT=0.5

# Intelligence ↔ Core 内部 HMAC（UTF-8 ≥ 32 字节；生产必须更换）
KB_INTERNAL_HMAC_SECRET=ai-rag-local-dev-hmac-secret-key!!
# 密钥轮换窗口：Core 短暂并行校验旧密钥；轮换完成后务必清空（见 docs/after/hmac-key-rotation.md）
KB_INTERNAL_HMAC_SECRET_PREVIOUS=
