# 公网 AI Profile 样例（复制相关键到 deploy/.env 后 import-nacos + 重启 intelligence/agent）
# AI_PROFILE=public

AI_DEV_STUB=false

# 模型库凭证加密密钥（第8阶段；AES-GCM，密钥缺失时模型库写接口拒写，读侧回退旧配置）
KB_SECURITY_ENCRYPT_KEY=change-me-to-a-long-random-secret

# ---------- 对话：通义默认 + DeepSeek 可选 ----------
QWEN_API_KEY=sk-your-dashscope-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-max

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---------- 硅基流动（与 qwen/deepseek 同级根节点；向量默认用这组）----------
SILICONFLOW_API_KEY=sk-your-siliconflow-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# RAG / ES 向量默认开
RAG_ENABLED=true
RAG_VECTOR_STORE=elasticsearch

# ---------- 向量方案 A（推荐）：硅基 BAAI/bge-m3（凭证走 SILICONFLOW_*）----------
RAG_EMBEDDING_PROVIDER=siliconflow
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=

# ---------- 向量方案 B：通义 text-embedding-v3（回退 QWEN_*）----------
# RAG_EMBEDDING_PROVIDER=qwen
# RAG_EMBEDDING_MODEL=text-embedding-v3
# RAG_EMBEDDING_DIMENSION=1024

RAG_RERANK_ENABLED=true
KAG_ENABLED=true
RAG_QDRANT_ENABLED=true
