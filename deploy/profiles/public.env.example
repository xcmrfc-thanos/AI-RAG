# 公网 AI Profile 样例（复制相关键到 deploy/.env 后 import-nacos + 重启 intelligence/agent）
# AI_PROFILE=public

AI_DEV_STUB=false

# ---------- 对话：通义默认 + DeepSeek 可选 ----------
QWEN_API_KEY=sk-your-dashscope-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-max

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---------- 向量方案 A：通义 text-embedding-v3（默认，维度 1024）----------
RAG_EMBEDDING_PROVIDER=qwen
RAG_EMBEDDING_MODEL=text-embedding-v3
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=

# ---------- 向量方案 B：硅基 BAAI/bge-m3（与方案 A 不可混用同一索引；切换后必须 rebuild）----------
# RAG_EMBEDDING_PROVIDER=siliconflow
# RAG_EMBEDDING_MODEL=BAAI/bge-m3
# RAG_EMBEDDING_DIMENSION=1024
# RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# RAG_EMBEDDING_API_KEY=sk-your-siliconflow-key

RAG_RERANK_ENABLED=true
KAG_ENABLED=true
