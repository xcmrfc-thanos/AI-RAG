# PostgreSQL Profile 样例（无真实密钥）
# 前置：执行 backend/sql/schema/postgresql/00_create_schemas.sql + install_all.sql
#       或 .\deploy\scripts\verify-pg-schema.ps1 验证翻译稿

KB_DB_TYPE=postgresql

PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=change_me

# Core 多数据源：每个 BC 一个 URL + currentSchema（示例）
# jdbc:postgresql://127.0.0.1:5432/postgres?currentSchema=kb_foundation
# jdbc:postgresql://127.0.0.1:5432/postgres?currentSchema=kb_user
# jdbc:postgresql://127.0.0.1:5432/postgres?currentSchema=kb_document
# 单库服务：
# jdbc:postgresql://127.0.0.1:5432/postgres?currentSchema=kb_statistics
# jdbc:postgresql://127.0.0.1:5432/postgres?currentSchema=kb_intelligence
# jdbc:postgresql://127.0.0.1:5432/postgres?currentSchema=kb_file
# jdbc:postgresql://127.0.0.1:5432/postgres?currentSchema=kb_agent
# driver: org.postgresql.Driver
# validation-query: SELECT 1

# Nacos：application-dev.yaml → kb.db.type=${KB_DB_TYPE:postgresql}
# 各服务 yaml 替换 driver-class-name / url / username / password 后执行 import-nacos.ps1
