# Oracle Profile 样例（无真实密钥）
# 前置：sqlplus 执行 backend/sql/schema/oracle/00_create_users.sql + install_all.sql
#       或 .\deploy\scripts\verify-oracle-schema.ps1（无镜像则 SKIP）

KB_DB_TYPE=oracle

ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1
ORACLE_USER=system
ORACLE_PASSWORD=change_me

# 推荐按 BC 用户连接（密码见 00_create_users.sql 默认 KbApp_ChangeMe，生产必改）：
# jdbc:oracle:thin:@//127.0.0.1:1521/XEPDB1
# username: kb_user | kb_document | kb_foundation | kb_statistics | kb_intelligence | kb_file | kb_agent
# driver: oracle.jdbc.OracleDriver
# validation-query: SELECT 1 FROM dual

# Core 多数据源示例（每源一个用户）：
# platform → kb_foundation / iam → kb_user / document → kb_document
# 业务模块需引入 ojdbc11（父 POM 已管理版本）

# Nacos：kb.db.type=oracle；替换各服务 datasource 后 import-nacos.ps1
