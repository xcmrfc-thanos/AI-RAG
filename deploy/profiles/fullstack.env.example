# 全栈 Compose 主机名覆盖（参考）
# docker-compose.full.yml 已内置同等环境变量；本文件仅作文档样例，勿与「本机 JVM」共用同一 import。

MYSQL_HOST=mysql
MYSQL_PORT=3306
REDIS_HOST=redis
REDIS_PORT=6379
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
MONGO_HOST=mongodb
MONGO_PORT=27017
ES_URL=http://elasticsearch:9200
ES_HOST=elasticsearch
NEO4J_URI=bolt://neo4j:7687
RUSTFS_ENDPOINT=rustfs
RUSTFS_PORT=9000
KB_CORE_URL=http://kb-core:8090
KB_FILE_URL=http://kb-file:8084
GATEWAY_BASE_URL=http://kb-gateway:18080
NACOS_ADDR=nacos:8848
NACOS_SERVER_ADDR=nacos:8848
