# MySQL 默认 Profile（与 deploy/env.example 对齐）
# 用法：copy 到 deploy/.env 或与现有 .env 合并后 import-nacos + 重启服务

KB_DB_TYPE=mysql

# 单机 Docker MySQL（宿主机端口见 MYSQL_PORT）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=20006
MYSQL_USER=root
MYSQL_PASSWORD=123456

# JDBC 形态（写入 Nacos 各 *-dev.yaml 的 spring.datasource）：
# jdbc:mysql://127.0.0.1:20006/kb_user?useUnicode=true&characterEncoding=UTF-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
# driver: com.mysql.cj.jdbc.Driver
# validation-query: SELECT 1

# 初始化：
#   deploy/scripts 中 MySQL import-schema / setup.ps1
