# 内网 AI Profile 样例（复制相关键到 deploy/.env 后 import-nacos + 重启 intelligence/agent）
# AI_PROFILE=intranet
#
# 前置：本机或内网已安装 Ollama，并拉取模型，例如：
#   ollama pull qwen2.5:7b
#   ollama pull bge-m3
# 实际 embedding 模型名以 `ollama list` 为准；若 embedding 走 TEI，改 RAG_EMBEDDING_BASE_URL。

AI_DEV_STUB=false

# ---------- 对话：Ollama OpenAI 兼容 ----------
QWEN_API_KEY=ollama
QWEN_BASE_URL=http://127.0.0.1:11434/v1
QWEN_MODEL=qwen2.5:7b
# 资源够可改为 qwen2.5:14b

# 内网通常不注册 DeepSeek
DEEPSEEK_API_KEY=

# ---------- 向量：bge-m3（维度 1024，与现网 mapping 对齐）----------
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_MODEL=bge-m3
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_API_KEY=ollama
RAG_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1

# 内网建议先关，省一次 LLM 调用；稳定后再开
RAG_RERANK_ENABLED=false
KAG_ENABLED=false

# 换向量模型后务必：
#   cd deploy/scripts
#   .\rebuild-es-indices.ps1
# （若开启 Qdrant，一并重建集合）
