# =============================================================================
# SkyWalking Java Agent 基础镜像
# 包含：Eclipse Temurin JRE 21 + Apache SkyWalking Agent 9.7.0
#
# 基于官方 apache/skywalking-java-agent 镜像构建（含完整 Agent）
# 添加到 AI-RAG 业务镜像的统一入口
# =============================================================================

FROM apache/skywalking-java-agent:9.7.0-java8 AS agent-source

# =============================================================================
# 最终镜像
# =============================================================================
FROM eclipse-temurin:21-jre-alpine

LABEL maintainer="AI-RAG Team"
LABEL description="JRE 21 with Apache SkyWalking Agent 9.7.0"
LABEL org.opencontainers.image.source="https://github.com/your-org/ai-rag"

# 从官方镜像复制 Agent
COPY --from=agent-source /skywalking/agent /opt/skywalking/agent

# 设置环境变量
ENV SKYWALKING_AGENT_HOME=/opt/skywalking/agent

# 常用调试工具
RUN apk add --no-cache curl bash tzdata \
    && ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone

# JVM 容器感知
ENV LANG=C.UTF-8 \
    JAVA_TOOL_OPTIONS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0"

WORKDIR /app

# 默认暴露端口（业务镜像覆盖）
EXPOSE 8080

# 默认健康检查（业务镜像覆盖）
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8080/actuator/health || exit 1