# kb-intelligence Nacos 配置（与 backend/nacos/kb-intelligence-dev.yaml.template 同步）
# 端口见 deploy/.env

server:
  port: 8091

spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:20006/kb_intelligence?useUnicode=true&characterEncoding=UTF-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: root
    password: 123456

  elasticsearch:
    uris: http://127.0.0.1:20920
    username: elastic
    password: susan123

  neo4j:
    uri: bolt://127.0.0.1:20687
    authentication:
      username: neo4j
      password: susan123

  data:
    redis:
      host: 127.0.0.1
      port: 20079
      password: susan123
      database: 2

  rabbitmq:
    host: 127.0.0.1
    port: 20572
    username: admin
    password: susan123

intelligence:
  indexing:
    document-index: kb_document
    chunk-index: kb_chunk

kb-core:
  url: http://localhost:8090
  internal:
    service: kb-intelligence
    secret: ${KB_INTERNAL_HMAC_SECRET:ai-rag-local-dev-hmac-secret-key!!}
    system-user-id: 1000000000000000001

rag:
  enabled: true
  vector-store: elasticsearch

kag:
  enabled: true
