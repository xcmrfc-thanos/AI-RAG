# kb-core Nacos 配置（本地 Docker，端口见 deploy/.env）
# 导入：KNOWLEDGE_BASE → kb-core-dev.yaml
# 切 PG/Oracle：三数据源同步改 driver/url/user（deploy/profiles/*.env.example）

spring:
  datasource:
    platform:
      type: com.alibaba.druid.pool.DruidDataSource
      driver-class-name: com.mysql.cj.jdbc.Driver
      url: jdbc:mysql://127.0.0.1:20006/kb_foundation?useUnicode=true&characterEncoding=UTF-8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
      # postgresql: jdbc:postgresql://127.0.0.1:5432/postgres?currentSchema=kb_foundation
      # oracle: jdbc:oracle:thin:@//127.0.0.1:1521/XEPDB1 + user kb_foundation
      username: root
      password: 123456
      druid:
        initial-size: 5
        min-idle: 5
        max-active: 20
        max-wait: 60000
        time-between-eviction-runs-millis: 60000
        min-evictable-idle-time-millis: 300000
        validation-query: SELECT 1
        test-while-idle: true
        test-on-borrow: false
        test-on-return: false
        pool-prepared-statements: true
        max-pool-prepared-statement-per-connection-size: 20
        filters: stat,wall
        connection-properties: druid.stat.mergeSql=true;druid.stat.slowSqlMillis=5000
    iam:
      type: com.alibaba.druid.pool.DruidDataSource
      driver-class-name: com.mysql.cj.jdbc.Driver
      url: jdbc:mysql://127.0.0.1:20006/kb_user?useUnicode=true&characterEncoding=UTF-8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
      username: root
      password: 123456
      druid:
        initial-size: 5
        min-idle: 5
        max-active: 20
        max-wait: 60000
        time-between-eviction-runs-millis: 60000
        min-evictable-idle-time-millis: 300000
        validation-query: SELECT 1
        test-while-idle: true
        test-on-borrow: false
        test-on-return: false
        pool-prepared-statements: true
        max-pool-prepared-statement-per-connection-size: 20
        filters: stat,wall
        connection-properties: druid.stat.mergeSql=true;druid.stat.slowSqlMillis=5000
    document:
      type: com.alibaba.druid.pool.DruidDataSource
      driver-class-name: com.mysql.cj.jdbc.Driver
      url: jdbc:mysql://127.0.0.1:20006/kb_document?useUnicode=true&characterEncoding=UTF-8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
      username: root
      password: 123456
      druid:
        initial-size: 20
        min-idle: 10
        max-active: 100
        max-wait: 60000
        time-between-eviction-runs-millis: 60000
        min-evictable-idle-time-millis: 300000
        validation-query: SELECT 1
        test-while-idle: true
        test-on-borrow: false
        test-on-return: false
        pool-prepared-statements: true
        max-pool-prepared-statement-per-connection-size: 20
        filters: stat,wall
        connection-properties: druid.stat.mergeSql=true;druid.stat.slowSqlMillis=5000
    druid:
      web-stat-filter:
        enabled: true
        url-pattern: /*
        exclusions: "*.js,*.gif,*.jpg,*.png,*.css,*.ico,/druid/*"
      stat-view-servlet:
        enabled: true
        url-pattern: /druid/*
        reset-enable: false
        login-username: admin
        login-password: admin

  servlet:
    multipart:
      enabled: true
      max-file-size: 20MB
      max-request-size: 20MB
      file-size-threshold: 2MB
      location: ${java.io.tmpdir}/kb-core-multipart

  elasticsearch:
    uris: http://127.0.0.1:20920
    username: elastic
    password: susan123
    connection-timeout: 10s
    socket-timeout: 30s

  data:
    mongodb:
      host: 127.0.0.1
      port: 20017
      auto-index-creation: true
      database: knowledge_base
      username: mongodb
      password: susan123
      authentication-database: knowledge_base

  rabbitmq:
    publisher-confirm-type: correlated
    publisher-returns: true
    template:
      mandatory: true
    listener:
      simple:
        acknowledge-mode: auto
        prefetch: 10

  cache:
    type: redis
    redis:
      time-to-live: 600000

  mail:
    host: ${MAIL_HOST:smtp.163.com}
    port: ${MAIL_PORT:465}
    username: ${MAIL_USERNAME:}
    password: ${MAIL_PASSWORD:}
    default-encoding: UTF-8
    properties:
      mail:
        smtp:
          auth: true
          ssl:
            enable: true
          starttls:
            enable: false
            required: false

app:
  frontend-url: ${APP_FRONTEND_URL:http://localhost:3002}
  activation-token-expiry-hours: 24

security:
  jwt:
    exclude-paths: >
      /ping,
      /modules,
      /auth/login,
      /auth/login/**,
      /auth/register,
      /auth/verify-email,
      /auth/verify-email/**,
      /auth/password/**,
      /auth/validate,
      /auth/users/by-role,
      /auth/reviewer-ids,
      /auth/test,
      /auth/test-error,
      /teams/tree,
      /teams/tree/**,
      /ws/**,
      /public/**,
      /actuator/**,
      /doc.html,
      /swagger-resources/**,
      /v3/api-docs/**,
      /webjars/**,
      /favicon.ico,
      /config/public,
      /share/**

document:
  indexing:
    # 终态 event；应急回退 legacy-feign；关闭 disabled（非法值启动失败）
    mode: event
    publish-max-attempts: 3
    publish-retry-backoff-ms: 200

file:
  upload:
    path: ./uploads
    max-size: 20971520
  server:
    rustfs:
      enabled: false
      base-url: http://localhost:18080

kb-file:
  url: http://localhost:8084

feign:
  client:
    config:
      default:
        connectTimeout: 5000
        readTimeout: 30000
        loggerLevel: basic
      kb-file:
        connectTimeout: 10000
        readTimeout: 600000
        loggerLevel: basic
  circuitbreaker:
    enabled: false

websocket:
  enabled: true
  path: /ws/notification
  allowed-origins: "*"

notification:
  retention-days: 90
  batch-size: 100

knife4j:
  enable: true
  setting:
    language: zh_cn
  production: false

kb-core:
  internal:
    enabled: true
    header-name: X-Internal-Service
    header-value: kb-intelligence
    timestamp-header: X-Internal-Timestamp
    signature-header: X-Internal-Signature
    # 本地默认仅供开发；生产必须由环境变量覆盖，UTF-8 长度 ≥ 32
    secret: ${KB_INTERNAL_HMAC_SECRET:ai-rag-local-dev-hmac-secret-key!!}
    # 密钥轮换窗口：短暂并行校验旧密钥；轮换完成后清空
    previous-secret: ${KB_INTERNAL_HMAC_SECRET_PREVIOUS:}
    max-clock-skew-seconds: 60
    system-user-id: 1000000000000000001
    allowed-paths:
      - /documents/page
      - /documents/*
      - /internal/users/*/team-ids
      - /internal/documents/visible-ids
logging:
  level:
    com.knowledge.base: debug
