# kb-statistics Nacos 配置（本地 Docker）
# 导入：KNOWLEDGE_BASE → kb-statistics-dev.yaml

spring:
  datasource:
    type: com.alibaba.druid.pool.DruidDataSource
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://127.0.0.1:20006/kb_statistics?useUnicode=true&characterEncoding=UTF-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: root
    password: 123456
    druid:
      initial-size: 5
      min-idle: 5
      max-active: 20
      max-wait: 60000
      time-between-eviction-runs-millis: 60000
      min-evictable-idle-time-millis: 300000
      validation-query: SELECT 1
      test-while-idle: true
      test-on-borrow: false
      test-on-return: false
      filters: stat,wall

  rabbitmq:
    listener:
      simple:
        acknowledge-mode: auto
        prefetch: 10

knife4j:
  enable: true
  setting:
    language: zh_cn
  production: false

logging:
  level:
    com.knowledge.base: debug
    org.springframework: info
  pattern:
    console: "%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{50} - %msg%n"

kb-core:
  url: http://localhost:8090
  internal:
    # 须与 Core header-value 一致（当前白名单为 kb-intelligence）
    service: kb-intelligence
    secret: ${KB_INTERNAL_HMAC_SECRET:ai-rag-local-dev-hmac-secret-key!!}
    system-user-id: 1000000000000000001
