# 公共 Nacos 配置（本地 Docker，端口见 deploy/.env）
# 导入：KNOWLEDGE_BASE → application-dev.yaml
# 各服务通过 spring.config.import 优先加载

spring:
  data:
    redis:
      host: ${REDIS_HOST:127.0.0.1}
      port: ${REDIS_PORT:20079}
      password: ${REDIS_PASSWORD:susan123}
      database: 2
      timeout: 10000ms
      lettuce:
        pool:
          max-active: 20
          max-wait: 3000ms
          max-idle: 10
          min-idle: 5
          time-between-eviction-runs: 30s

  rabbitmq:
    host: ${RABBITMQ_HOST:127.0.0.1}
    port: ${RABBITMQ_PORT:20572}
    username: ${RABBITMQ_USER:admin}
    password: ${RABBITMQ_PASSWORD:susan123}
    virtual-host: /

  jackson:
    date-format: yyyy-MM-dd HH:mm:ss
    time-zone: GMT+8
    default-property-inclusion: non_null

jwt:
  secret: knowledge-base-secret-key-for-jwt-token-generation-must-be-long-enough
  expiration: 7200
  refresh-expiration: 604800
  header: Authorization
  prefix: Bearer
  issuer: knowledge-base

# 关系数据库方言（一部署一方言）：mysql | postgresql | oracle
# 切库：改 KB_DB_TYPE + 各服务 datasource（样例见 deploy/profiles/*.env.example）后 import-nacos
kb:
  db:
    type: ${KB_DB_TYPE:mysql}

logging:
  level:
    root: INFO
