# kb-agent Nacos 配置（本地 Docker）
# 导入：KNOWLEDGE_BASE → kb-agent-dev.yaml

spring:
  datasource:
    type: com.alibaba.druid.pool.DruidDataSource
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://127.0.0.1:20006/kb_agent?useUnicode=true&characterEncoding=UTF-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: root
    password: 123456
    druid:
      initial-size: 3
      min-idle: 3
      max-active: 20
      max-wait: 60000
      validation-query: SELECT 1
      test-while-idle: true

knife4j:
  enable: true
  setting:
    language: zh_cn
  production: false

# 与模块 application.yml 同值兜底；准源为本 Nacos 配置
agent:
  default-model: qwen
  gateway-base-url: http://127.0.0.1:8080
  run-retention-days: 30
  llm:
    qwen:
      api-key: ${QWEN_API_KEY:}
      base-url: ${QWEN_BASE_URL:https://dashscope.aliyuncs.com/compatible-mode/v1}
      model: ${QWEN_MODEL:qwen3-max}
    deepseek:
      api-key: ${DEEPSEEK_API_KEY:}
      base-url: https://api.deepseek.com/v1
      model: deepseek-chat
  timeouts:
    run-seconds: 90
    llm-seconds: 60
    tool-seconds: 5

ai:
  dev-stub-enabled: ${AI_DEV_STUB:false}

logging:
  level:
    com.knowledge.base.agent: debug
