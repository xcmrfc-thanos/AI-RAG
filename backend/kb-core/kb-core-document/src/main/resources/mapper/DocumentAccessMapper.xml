<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.knowledge.base.document.mapper.DocumentAccessMapper">

    <resultMap id="BaseResultMap" type="com.knowledge.base.document.entity.DocumentAccess">
        <id column="id" property="id" />
        <result column="user_id" property="userId" />
        <result column="document_id" property="documentId" />
        <result column="document_title" property="documentTitle" />
        <result column="category_id" property="categoryId" />
        <result column="category_name" property="categoryName" />
        <result column="access_time" property="accessTime" />
        <result column="ip_address" property="ipAddress" />
        <result column="user_agent" property="userAgent" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
        <result column="deleted" property="deleted" />
        <result column="summary" property="summary" />
        <result column="author_name" property="authorName" />
        <result column="status" property="status" />
    </resultMap>

    <!-- 最近访问（默认 MySQL/PG LIMIT） -->
    <select id="selectRecentAccessByUserId" resultMap="BaseResultMap">
        SELECT da.*, d.summary, d.category_id, c.category_name, d.author_name, d.status
        FROM kb_document_access da
        LEFT JOIN kb_document d ON da.document_id = d.id
        LEFT JOIN kb_category c ON d.category_id = c.id
        WHERE da.user_id = #{userId} AND d.deleted = 0
        ORDER BY da.access_time DESC
        LIMIT #{limit}
    </select>

    <!-- Oracle：LIMIT 改 FETCH FIRST -->
    <select id="selectRecentAccessByUserId" databaseId="oracle" resultMap="BaseResultMap">
        SELECT da.*, d.summary, d.category_id, c.category_name, d.author_name, d.status
        FROM kb_document_access da
        LEFT JOIN kb_document d ON da.document_id = d.id
        LEFT JOIN kb_category c ON d.category_id = c.id
        WHERE da.user_id = #{userId} AND d.deleted = 0
        ORDER BY da.access_time DESC
        FETCH FIRST #{limit} ROWS ONLY
    </select>

    <delete id="deleteByUserIdAndDocumentId">
        DELETE FROM kb_document_access
        WHERE user_id = #{userId} AND document_id = #{documentId}
    </delete>

    <delete id="deleteAllByUserId">
        DELETE FROM kb_document_access
        WHERE user_id = #{userId}
    </delete>

</mapper>
